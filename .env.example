# Full experience (b2c-ui-main) — copy to b2c-ui-main/.env.local
OPENAI_API_KEY=sk-...

# Post-session debrief analyzer (default in code: gpt-5.6-terra)
ARENA_LLM_MODEL=gpt-5.6-terra

# Optional: low/medium/high — analyzer uses medium, retries with low
# ARENA_LLM_REASONING_EFFORT=medium

# Live voice actor (default: gpt-realtime-2.1)
ARENA_REALTIME_MODEL=gpt-realtime-2.1
