{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cp src/middleware.demo.ts src/middleware.ts && npm run build",
  "installCommand": "npm install",
  "env": {
    "ARENA_LLM_MODEL": "anthropic/claude-sonnet-4.5",
    "ARENA_ANALYZER_VERSION": "v2",
    "ARENA_REALTIME_MODEL": "gpt-realtime-2.1"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/arena/exp7/pre-post",
      "permanent": false
    }
  ]
}
